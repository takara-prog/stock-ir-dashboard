# =========================================================
# X AI Monitor - Environment Variables
# =========================================================
# Copy this file to .env and fill in your values.
# cp .env.example .env

# ---------------------------------------------------------
# X (Twitter) API
# Bearer Token — requires X Basic plan ($100/mo) or higher
# https://developer.x.com/en/portal/dashboard
# ---------------------------------------------------------
TWITTER_API_KEY=

# ---------------------------------------------------------
# Anthropic Claude API Key
# https://console.anthropic.com/settings/keys
# ---------------------------------------------------------
ANTHROPIC_API_KEY=

# ---------------------------------------------------------
# Telegram Bot (for weekly report delivery)
# 1. Chat with @BotFather → /newbot → copy Token
# 2. Send a message to your bot, then visit:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
#    to find your chat_id
# ---------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------
# Monitor settings
# ---------------------------------------------------------
# Keyword to search on X (can also be changed via /config)
MONITOR_KEYWORD=株

# Daily collection time in JST (0–23)
COLLECT_HOUR=8

# Day to run weekly analysis (MON/TUE/WED/THU/FRI/SAT/SUN)
ANALYZE_WEEKDAY=MON

# ---------------------------------------------------------
# Internal (usually no need to change)
# ---------------------------------------------------------
# SQLite database file path inside the container
DB_PATH=/data/tweets.db
